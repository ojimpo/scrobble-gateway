# Required: https://www.last.fm/api/account/create
LASTFM_API_KEY=replace-with-your-lastfm-api-key
LASTFM_USERNAME=replace-with-your-lastfm-username

# MCP HTTP server
MCP_HOST=0.0.0.0
MCP_PORT=3000
# Host publication is loopback-only by default. Change only when your proxy runs elsewhere.
MCP_BIND_ADDRESS=127.0.0.1
MCP_PUBLIC_PORT=3000
# Comma-separated hostnames accepted by Host validation. Add your public hostname.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Keep false on an unauthenticated public endpoint. Enable only behind OAuth/private access.
MCP_ENABLE_MUTATIONS=false

# OAuth 2.1 for /mcp (claude.ai and ChatGPT connectors). Set both to enable;
# setting only one refuses to start. The passphrase is typed on the consent page.
# MCP_PUBLIC_URL=https://scrobble-gateway.example.com
# MCP_OAUTH_PASSPHRASE=at-least-12-characters
# Client registrations and token hashes. Without it a restart forces re-authorization.
MCP_OAUTH_STORE=/app/data/oauth-store.json
# Behind cloudflared/another proxy, so passphrase rate limiting sees the real client IP.
MCP_TRUST_PROXY=1
# REST for services on the same Docker network (health-ojimpo). Not published
# by compose, so it never goes through the tunnel. 0 disables it.
INTERNAL_API_PORT=3001
# Starting HTTP without OAuth must be explicit.
# MCP_ALLOW_UNAUTHENTICATED=true

# Last.fm client safeguards
LASTFM_API_BASE_URL=https://ws.audioscrobbler.com/2.0/
LASTFM_TIMEOUT_MS=10000
LASTFM_MAX_RETRIES=3
LASTFM_MIN_REQUEST_INTERVAL_MS=250
LASTFM_CACHE_TTL_SECONDS=300

# MusicBrainz is keyless, but its API requires an identifiable User-Agent.
# Replace the contact URL/email if you deploy your own copy.
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2/
MUSICBRAINZ_USER_AGENT=lastfm-mcp/0.2.0 (https://lastfm.mcp.sptm.online/)
MUSICBRAINZ_TIMEOUT_MS=10000
MUSICBRAINZ_MAX_RETRIES=2
# MusicBrainz asks clients to stay at or below one request per second.
MUSICBRAINZ_MIN_REQUEST_INTERVAL_MS=1100

# Persistent normalized scrobble index
HISTORY_DB_PATH=/app/data/lastfm.sqlite
HISTORY_LIVE_SCAN_LIMIT=5000
HISTORY_MAX_SYNC_TRACKS=250000
# Incremental syncs re-read this many hours before the newest indexed scrobble.
# Spotify scrobbles reach Last.fm late and out of order; 0 restores the strict cursor.
HISTORY_INCREMENTAL_LOOKBACK_HOURS=72
# On startup and every interval, sync the index: a full (resumable) backfill
# until the whole history is indexed, incremental afterwards.
HISTORY_AUTO_SYNC_ENABLED=true
HISTORY_AUTO_SYNC_INTERVAL_SECONDS=3600

# Spotify Like → Last.fm Love for recently played tracks only (off | dry-run | on).
# After each history sync, tracks scrobbled within the window that are liked on
# Spotify get loved on Last.fm. Needs Spotify credentials, LASTFM_API_SECRET and
# both auth flows below, and SPOTIFY_AUTO_SYNC_ENABLED=false (the whole-library
# sync would love every liked track at once). Never unloves.
LIKE_LOVE_SYNC=off
LIKE_LOVE_WINDOW_HOURS=72
# How long the liked-library snapshot is reused before paging through it again.
LIKE_LOVE_LIKED_CACHE_HOURS=6

# Optional Spotify integration. Leave both empty to retain Last.fm-only behavior.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Register this EXACT URI in the Spotify developer dashboard (localhost is not accepted).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Defaults to the directory containing HISTORY_DB_PATH; included in the Docker data volume.
# SPOTIFY_TOKEN_PATH=/app/data/spotify-tokens.json

# Required for loving tracks on Last.fm; obtain the shared secret from your Last.fm API account.
LASTFM_API_SECRET=
# LASTFM_SESSION_PATH=/app/data/lastfm-session.json

# On startup and every hour after each completed run, add Spotify likes to Last.fm loves.
# Only active when Spotify credentials are configured. Authorize BOTH services using the CLI.
# Set false while previewing the initial import or to disable all background music writes.
SPOTIFY_AUTO_SYNC_ENABLED=true
SPOTIFY_AUTO_SYNC_INTERVAL_SECONDS=3600
# Shared queue for all Spotify API calls (MCP and background sync).
SPOTIFY_MIN_REQUEST_INTERVAL_MS=2000
SPOTIFY_MAX_QUEUE_WAIT_MS=60000
# Read cache; synchronization always refreshes the liked-library snapshot.
SPOTIFY_CACHE_TTL_SECONDS=60
SPOTIFY_SEARCH_CACHE_TTL_SECONDS=3600
# Spotify exposes private account data: enable these MCP tools only behind trusted access control.
# Background sync works independently of this flag and MCP_ENABLE_MUTATIONS.
MCP_ENABLE_SPOTIFY_TOOLS=false
